
# Grids are 'N' (cubic) or 'WxHxD'. The three are in storage order, the order of the file
# and of the metadata's 'Grid size:', which is galactic (X, Z, -Y) - a flat disk, whose
# thickness is the galactic Z, wants the middle number small (e.g. 400x40x400).
#
# The box is normalized: its largest side is 1, in units of the object's size in the scene,
# so the object's sizePc decides how large the volume is drawn and the data only decides its
# shape. A voxel size of 1/400 therefore asks for 400 voxels along the largest axis.
# --no-normalize keeps the box in the source units, where the metadata bounds also acted as
# a size multiplier on the object (a box of side 7 drew the volume 7 times the declared
# size); volumes written either way must not be mixed.
#
# The density blur is a length in the world, not a count of voxels: by default 0.85 of the
# channel's *local* inter-particle spacing (the median distance from a particle to its
# neighbours, in CHANNEL_SIGMA_LOCAL in particles-to-3dtex.py). Local, not the mean spacing of
# the box: the box figure assumes the channel fills the box, and the dust does not - it is a
# thin disk in a few percent of it - so sizing by the box gave the dust a blur 3.5x thicker
# than the disk itself, which is what "puffy" is. Both figures are lengths on the particles, so
# the same particles drawn at 200 and at 800 get the same galaxy.
#
# One fraction cannot be right for every channel at once - a dense thin disk and a diffuse halo
# want different amounts - so --sigma overrides it per channel, as a fraction of that channel's
# own spacing:
#
#     just texvoxelgroup 0.00125 'Gas+Bulge:0.6|ArmDust' <in> <out> --sigma dust=0.4
#
# The resulting width, in world units and in this grid's voxels, is in each channel's metadata,
# alongside the two lengths it was sized and capped by - which is the cheap way to tell whether
# two runs were generated to look the same.
#
#
# VARIADIC ARGS ARE INTERPOLATED UNQUOTED. '{{args}}' splices the extra arguments into
# the command line as raw text, so anything the shell reads as syntax breaks: a group
# spec contains a '|', and `--group 'Gas+Bulge:0.6|ArmDust'` arrives at the recipe as
# `--group Gas+Bulge:0.6|ArmDust`, where the shell takes the '|' for a pipe ("ArmDust:
# command not found"). Recipes that take a group spec therefore take it as a *named*
# parameter and quote it themselves; for the others, escape the metacharacter
# (`--group Gas+Bulge:0.6\|ArmDust`), which the shell then hands over intact.

# Generate the emissive and occlusive galaxy volumes in one go, from the particle channels.
#
#     just volume 400 <in> <out>
#     just volume 400 <in> <out> --intensity Bulge=0.3
#
# 'resolution' is the number of voxels along the longest side of the box; the other axes follow
# the shape of the data, so the voxels stay cubic. Extra arguments go straight to the script:
# --intensity NAME=FLOAT (0..1, repeatable) dims one channel, and nothing else is exposed here
# because nothing else is needed for the usual run. This writes <prefix>_emissive_rgba.raw.gz and
# <prefix>_occlusive_rgba.raw.gz, which are the two textures the scene's volume0/volume1 want.
volume resolution input output *args:
	uv run --with numpy --with scipy python particles-to-volume.py {{resolution}} {{input}} {{output}} {{args}}

# Create a 3D texture from particle data using smart method.
tex gridsize formats input output *args:
	uv run --with numpy --with scipy --with tqdm python particles-to-3dtex.py --method smart --grid-size '{{gridsize}}' --format '{{formats}}' {{args}} {{input}} {{output}}

# Create a 3D texture from particle data using fast method.
texfast gridsize input output:
	uv run --with numpy --with scipy --with tqdm python particles-to-3dtex.py --method ultrafast --grid-size '{{gridsize}}' {{input}} {{output}}

# Create a 3D texture with a voxel size instead of a grid: the grid follows the box on
# each axis, so the detail of an N^3 grid is kept without spending voxels on the axes the
# data has no extent in. This is the usual way to make a flat volume.
texvoxel voxelsize input output *args:
	uv run --with numpy --with scipy --with tqdm python particles-to-3dtex.py --method smart --voxel-size {{voxelsize}} --format rgba {{args}} {{input}} {{output}}

# Same, and merge the channels into one emissive and one occlusive texture in one go.
# 'group' is a positional argument ('<emissive>|<occlusive>', each side a '+'-separated
# list of channel names with an optional ':weight'), because a group spec cannot travel
# through *args - see the note at the top of this file.
alias gen := texvoxelgroup
texvoxelgroup voxelsize group input output *args:
	uv run --with numpy --with scipy --with tqdm python particles-to-3dtex.py --method ultrafast --voxel-size {{voxelsize}} --format rgba --group '{{group}}' {{args}} {{input}} {{output}}

# Convert particles and merge the channels into one emissive and one occlusive
# texture in one go. 'group' is '<emissive>|<occlusive>', each side a
# '+'-separated list of channel names with an optional ':weight', e.g.
# 'Gas+Bulge:0.6|ArmDust'.
texgroup gridsize group input output:
	uv run --with numpy --with scipy --with tqdm python particles-to-3dtex.py --method smart --grid-size '{{gridsize}}' --format rgba --group '{{group}}' {{input}} {{output}}

# Merge volume textures into an emissive and an occlusive one. The options are passed
# straight through, e.g. (all on one line):
#   just combine out --emissive galaxy_Gas_rgba.raw.gz --occlusive galaxy_ArmDust_rgba.raw.gz
# Do not insert a '--' before them: just only treats it as a separator *before* the
# recipe name, so it would be forwarded to the script and rejected by argparse.
combine output *args:
	uv run --with numpy python combine-volumes.py -o {{output}} {{args}}

# Verify a merge: merge each input on its own and compare with the original file.
combine-check output *args:
	uv run --with numpy python combine-volumes.py --check -o {{output}} {{args}}

# Visualize a 3D texture file. Needs the path to the file.
vis file:
	uv run --with numpy --with vedo view-volume-raw.py {{file}}

# Visualize slices of a 3D texture file. Needs the path to the file.
slices file:
	uv run --with numpy --with vedo view-volume-slices.py {{file}}
