#ifndef GLSL_LIB_DOUBLEFLOAT_TRIG
#define GLSL_LIB_DOUBLEFLOAT_TRIG
// Sine and cosine of a double-float angle. Requires doublefloat.glsl first; in its own file so
// shaders that only need the arithmetic do not pay for the table.

// pi/16 as a double-float
const vec2 DS_PI16 = vec2(0.19634954631328583, -5.463923535842241e-09);

// cos(k*pi/16), sin(k*pi/16) as (cos_hi, cos_lo, sin_hi, sin_lo), k = 0..31
const vec4 DS_TRIG[32] = vec4[32](
    vec4(1.0, 0.0, 0.0, 0.0),
    vec4(0.9807852506637573, 2.9739473106360492e-08, 0.19509032368659973, -1.670471427850373e-09),
    vec4(0.9238795042037964, 2.830748968563057e-08, 0.3826834261417389, 6.2233507236442165e-09),
    vec4(0.8314695954322815, 1.687026340846387e-08, 0.5555702447891235, -1.1769521357507529e-08),
    vec4(0.7071067690849304, 1.2101617485882343e-08, 0.7071067690849304, 1.2101617485882343e-08),
    vec4(0.5555702447891235, -1.1769521357507529e-08, 0.8314695954322815, 1.687026340846387e-08),
    vec4(0.3826834261417389, 6.2233507236442165e-09, 0.9238795042037964, 2.830748968563057e-08),
    vec4(0.19509032368659973, -1.670471427850373e-09, 0.9807852506637573, 2.9739473106360492e-08),
    vec4(0.0, 0.0, 1.0, 0.0),
    vec4(-0.19509032368659973, 1.670471427850373e-09, 0.9807852506637573, 2.9739473106360492e-08),
    vec4(-0.3826834261417389, -6.2233507236442165e-09, 0.9238795042037964, 2.830748968563057e-08),
    vec4(-0.5555702447891235, 1.1769521357507529e-08, 0.8314695954322815, 1.687026340846387e-08),
    vec4(-0.7071067690849304, -1.2101617485882343e-08, 0.7071067690849304, 1.2101617485882343e-08),
    vec4(-0.8314695954322815, -1.687026340846387e-08, 0.5555702447891235, -1.1769521357507529e-08),
    vec4(-0.9238795042037964, -2.830748968563057e-08, 0.3826834261417389, 6.2233507236442165e-09),
    vec4(-0.9807852506637573, -2.9739473106360492e-08, 0.19509032368659973, -1.670471427850373e-09),
    vec4(-1.0, 0.0, 0.0, 0.0),
    vec4(-0.9807852506637573, -2.9739473106360492e-08, -0.19509032368659973, 1.670471427850373e-09),
    vec4(-0.9238795042037964, -2.830748968563057e-08, -0.3826834261417389, -6.2233507236442165e-09),
    vec4(-0.8314695954322815, -1.687026340846387e-08, -0.5555702447891235, 1.1769521357507529e-08),
    vec4(-0.7071067690849304, -1.2101617485882343e-08, -0.7071067690849304, -1.2101617485882343e-08),
    vec4(-0.5555702447891235, 1.1769521357507529e-08, -0.8314695954322815, -1.687026340846387e-08),
    vec4(-0.3826834261417389, -6.2233507236442165e-09, -0.9238795042037964, -2.830748968563057e-08),
    vec4(-0.19509032368659973, 1.670471427850373e-09, -0.9807852506637573, -2.9739473106360492e-08),
    vec4(0.0, 0.0, -1.0, 0.0),
    vec4(0.19509032368659973, -1.670471427850373e-09, -0.9807852506637573, -2.9739473106360492e-08),
    vec4(0.3826834261417389, 6.2233507236442165e-09, -0.9238795042037964, -2.830748968563057e-08),
    vec4(0.5555702447891235, -1.1769521357507529e-08, -0.8314695954322815, -1.687026340846387e-08),
    vec4(0.7071067690849304, 1.2101617485882343e-08, -0.7071067690849304, -1.2101617485882343e-08),
    vec4(0.8314695954322815, 1.687026340846387e-08, -0.5555702447891235, 1.1769521357507529e-08),
    vec4(0.9238795042037964, 2.830748968563057e-08, -0.3826834261417389, -6.2233507236442165e-09),
    vec4(0.9807852506637573, 2.9739473106360492e-08, -0.19509032368659973, 1.670471427850373e-09)
);

// sin and cos of a double-float angle
void ds_sinCos(vec2 a, out vec2 c, out vec2 s) {
    float kf = floor(a.x / DS_PI16.x + 0.5);
    vec2 d = ds_sub(a, ds_mul(ds_set(kf), DS_PI16));  // |d| <= ~pi/32
    int k = int(mod(kf, 32.0));
    vec4 t = DS_TRIG[k];
    vec2 c0 = t.xy;
    vec2 s0 = t.zw;
    float df = d.x;
    float d2 = df * df;
    vec2 d2ds = ds_mul(d, d);
    // cos d = 1 - d^2/2 + d^4/24 - d^6/720 + d^8/40320
    float chigh = d2 * d2 * (1.0 / 24.0 - d2 * (1.0 / 720.0 - d2 * (1.0 / 40320.0)));
    vec2 cd = ds_add(ds_sub(ds_set(1.0), ds_mul(d2ds, ds_set(0.5))), ds_set(chigh));
    // sin d = d - d^3/6 + d^5/120 - d^7/5040
    float shigh = df * d2 * (1.0 / 6.0 - d2 * (1.0 / 120.0 - d2 * (1.0 / 5040.0)));
    vec2 sd = ds_sub(d, ds_set(shigh));
    c = ds_sub(ds_mul(c0, cd), ds_mul(s0, sd));
    s = ds_add(ds_mul(s0, cd), ds_mul(c0, sd));
}
#endif
